package {
    default_team: "trendy_team_context_hub",
    default_applicable_licenses: ["system_chre_license"],
}

cc_library {
    name: "contexthub_data_flow",
    vendor_available: true,
    host_supported: true,
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: ["queue.cc"],
    local_include_dirs: ["include"],
    export_include_dirs: ["include"],
    header_libs: [
        "pw_assert",
    ],
    export_header_lib_headers: [
        "pw_assert",
    ],
    shared_libs: ["liblog"],
    static_libs: [
        "pw_allocator",
        "pw_bytes",
        "pw_containers",
        "pw_function",
        "pw_result",
        "pw_span",
        "pw_status",
    ],
    export_static_lib_headers: [
        "pw_allocator",
        "pw_bytes",
        "pw_containers",
        "pw_function",
        "pw_result",
        "pw_span",
        "pw_status",
    ],
}

cc_test_host {
    name: "contexthub_data_flow_unit_tests",
    srcs: ["test/queue_test.cc"],
    local_include_dirs: ["include"],
    header_libs: [
        "pw_assert",
    ],
    export_header_lib_headers: [
        "pw_assert",
    ],
    shared_libs: [
        "contexthub_data_flow",
        "liblog",
    ],
    static_libs: [
        "libgmock",
        "libgtest",
        "pw_allocator",
        "pw_bytes",
        "pw_containers",
        "pw_function",
        "pw_span",
        "pw_status",
        "pw_result",
    ],
    sanitize: {
        address: true,
    },
}

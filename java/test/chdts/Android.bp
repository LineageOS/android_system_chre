package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_host {
    name: "chdts-tradefed-host",
    srcs: ["src/**/*.java"],
    java_resource_dirs: ["res"],
    libs: [
        "tradefed",
        "compatibility-host-util",
    ],
}

tradefed_binary_host {
    name: "chdts-tradefed",
    wrapper: "tools/chdts-tradefed",
    short_name: "CHDTS",
    full_name: "Context Hub Development Test Suite",
    version: "1.0",
    static_libs: [
        "chdts-tradefed-host",
        "cts-tradefed-harness",
    ],
    required: [
        "compatibility-host-util",
        // "ChdtsTestApp",
    ],
}

compatibility_test_suite_package {
    name: "chdts",
    tradefed: "chdts-tradefed",
    readme: "README.md",
}

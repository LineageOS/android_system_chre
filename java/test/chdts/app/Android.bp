package {
    default_team: "trendy_team_context_hub",
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

android_library {
    name: "ChreTestSuiteAppLib",
    manifest: "LibraryManifest.xml",
    aidl: {
        local_include_dirs: ["aidl"],
    },
    srcs: [
        "aidl/**/I*.aidl",
        "src/**/*.java",
    ],
    exclude_srcs: [
        "src/**/GtsContextHubStressTest.java",
    ],
    asset_dirs: ["assets"],
    libs: ["android.test.runner.stubs"],
    static_libs: [
        "flag-junit",
        "androidx.test.rules",
        "compatibility-device-util-axt",
        "context-hub-endpoint-test",
        "context-hub-settings-test",
        "chre-cross-validation",
        "chre-test-utils",
        "chqts",
        "context-hub-audio-concurrency-test",
        "context-hub-ble-concurrency-test",
        "context-hub-chre-concurrency-test",
        "context-hub-permissions-test",
        "context-hub-rpc-service-test",
        "android.chre.flags-aconfig-java",
    ],
    sdk_version: "test_current",
    min_sdk_version: "21",
}

android_test_helper_app {
    name: "ChdtsTestApp",
    srcs: [
        "src/**/GtsContextHubStressTest.java",
    ],
    dex_preopt: {
        enabled: false,
    },
    optimize: {
        enabled: false,
    },
    static_libs: [
        "ChreTestSuiteAppLib",
        "flag-junit",
        "androidx.test.rules",
        "compatibility-device-util-axt",
        "context-hub-endpoint-test",
        "context-hub-settings-test",
        "chre-cross-validation",
        "chre-test-utils",
        "chqts",
        "context-hub-audio-concurrency-test",
        "context-hub-ble-concurrency-test",
        "context-hub-chre-concurrency-test",
        "context-hub-permissions-test",
        "context-hub-rpc-service-test",
        "context-hub-stress-test",
        "android.chre.flags-aconfig-java",
    ],
    sdk_version: "test_current",
    min_sdk_version: "21",
    dxflags: ["--multi-dex"],
    test_suites: [
        "chdts",
    ],
}

<configuration description="Config for ChdtsHostTestCases">
    <option name="test-suite-tag" value="chdts" />
    <option name="config-descriptor:metadata" key="component" value="location" />
    <option name="config-descriptor:metadata" key="parameter" value="all_foldable_states" />

    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" >
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer" >
        <option name="push-file" key="ChdtsTestApp.apk" value="/system/priv-app/ChdtsTestApp.apk" />
        <option name="push-file" key="chre-priv-permissions.xml" value="/etc/permissions/chre-priv-permissions.xml" />
        <option name="abort-on-push-failure" value="true" />
        <option name="cleanup" value="true" />
        <option name="remount-system" value="true" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.RebootTargetPreparer" >
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" >
    </target_preparer>

    <!-- Environment setup -->
    <target_preparer class="com.android.tradefed.targetprep.DeviceSetup">
        <option name="screen-always-on" value="on" />
        <option name="screen-adaptive-brightness" value="off" />
        <option name="bluetooth" value="ON" />
        <option name="wifi" value="ON" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="settings put secure location_mode 3" />
        <option name="run-command" value="settings put global wifi_scan_throttle_enabled 0" />
        <!-- Cleanups -->
        <option name="teardown-command" value="svc power stayon false" />
        <option name="teardown-command" value="settings put global wifi_scan_throttle_enabled 1" />
    </target_preparer>

    <!-- Runtime permissions must be granted manually -->
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="pm grant com.android.chre.chdts.app android.permission.ACCESS_FINE_LOCATION" />
        <option name="run-command" value="pm grant com.android.chre.chdts.app android.permission.ACCESS_BACKGROUND_LOCATION" />
        <option name="run-command" value="pm grant com.android.chre.chdts.app android.permission.ACTIVITY_RECOGNITION" />
        <option name="run-command" value="pm grant com.android.chre.chdts.app android.permission.BLUETOOTH_CONNECT" />
        <option name="run-command" value="pm grant com.android.chre.chdts.app android.permission.BLUETOOTH_SCAN" />
        <option name="run-command" value="pm grant com.android.chre.chdts.app android.permission.RECORD_AUDIO" />
    </target_preparer>

    <!-- Wait 15 seconds for boot completion, to avoid probabilistic failure of testContextHubEstimatedHostTimeTest -->
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="sleep 15" />
    </target_preparer>

    <test class="com.android.tradefed.testtype.HostTest" >
        <option name="jar" value="chdts-tradefed-tests.jar" />
    </test>
    <logger class="com.android.tradefed.log.FileLogger" />
</configuration>
